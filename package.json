{
  "name": "tphira-mp",
  "author": "Pimeng",
  "license": "AGPL-3.0",
  "version": "1.9",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:server": "tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "bundle:server": "node tools/bundle-server.mjs",
    "package:sea": "node tools/package-sea.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:memory": "cross-env NODE_OPTIONS='--expose-gc' vitest run --config vitest.config.memory.ts",
    "bench": "tsx bench/run-all.ts",
    "bench:connect": "tsx bench/connect-bench.ts",
    "bench:room": "tsx bench/room-bench.ts",
    "bench:gameplay": "tsx bench/gameplay-bench.ts"
  },
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@fluent/bundle": "^0.18.0",
    "@fluent/langneg": "^0.7.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.5.13",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "knip": "^6.14.1",
    "postject": "1.0.0-alpha.6",
    "ts-prune": "^0.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
